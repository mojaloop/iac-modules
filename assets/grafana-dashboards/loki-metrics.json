{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Shows metrics of log errors from Loki",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "DNS timeout errors (EAI_AGAIN)",
      "fieldConfig": {
        "defaults": {
          "unit": "logs/sec"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, loki_log_dns_timeout_lines_rate)",
          "legendFormat": "{{namespace}}/{{app}}/{{container}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "DNS Timeout Errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "DNS not found errors (ENOTFOUND)",
      "fieldConfig": {
        "defaults": {
          "unit": "logs/sec"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, loki_log_dns_not_found_lines_rate)",
          "legendFormat": "{{namespace}}/{{app}}/{{container}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "DNS Not Found Errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "MySQL connection lost errors",
      "fieldConfig": {
        "defaults": {
          "unit": "logs/sec"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, loki_log_mysql_connection_lost_lines_rate)",
          "legendFormat": "{{namespace}}/{{app}}/{{container}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "MySQL Connection Lost",
      "type": "timeseries"
    }
  ],
  "preload": false,
  "schemaVersion": 41,
  "tags": ["loki", "logs", "ruler"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5m", "15m", "30m", "1h"]
  },
  "timezone": "browser",
  "title": "Loki Metrics",
  "uid": "loki-dns-db-errors-v001",
  "version": 1
}
