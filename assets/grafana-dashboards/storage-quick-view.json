      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "description": "Indicates buckets which are very near to bucket quota limit. NOTE: bucket quota is being enforced using users quota",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 0.8
                }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 15,
          "x": 0,
          "y": 10
        },
        "id": 10,
        "options": {
          "cellHeight": "sm",
          "footer": {
            "countRows": false,
            "fields": "",
            "reducer": [
              "sum"
            ],
            "show": false
          },
          "showHeader": true
        },
        "pluginVersion": "11.1.1",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "exemplar": false,
            "expr": "sum(radosgw_usage_user_total_bytes{cluster=~\"$cluster\"}) by (user) / \nsum(radosgw_usage_user_quota_size_bytes{cluster=~\"$cluster\"} ) by (user) > 0.8 ",
            "format": "table",
            "hide": false,
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "B"
          }
        ],
        "title": "Buckets approaching max quota limit",
        "transformations": [
          {
            "id": "filterFieldsByName",
            "options": {
              "include": {
                "names": [
                  "user",
                  "Value"
                ]
              }
            }
          },
          {
            "id": "renameByRegex",
            "options": {
              "regex": "user",
              "renamePattern": "bucket"
            }
          }
        ],
        "type": "table"
